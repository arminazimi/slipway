{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Slipway theme tokens (W3C Design Tokens format). Three tiers: primitive, semantic, component. Run `npm run build:tokens` after editing.",
  "primitive": {
    "sand": {
      "100": { "$type": "color", "$value": "#efe8de", "$description": "Raised sand, the light surface." },
      "200": { "$type": "color", "$value": "#e9e1d6", "$description": "Muted sand, the light page." },
      "300": { "$type": "color", "$value": "#c9b8ad", "$description": "Sand line, hairlines on light." }
    },
    "ink": {
      "700": { "$type": "color", "$value": "#3b3330", "$description": "Soft brown ink, light text and headings." },
      "500": { "$type": "color", "$value": "#65574f", "$description": "Quiet ink, light muted text." }
    },
    "rose": {
      "700": { "$type": "color", "$value": "#7a4f4f", "$description": "Deep desert rose, text and fills on light." },
      "400": { "$type": "color", "$value": "#b58d90", "$description": "Dusty desert rose, text on dark." },
      "600": { "$type": "color", "$value": "#7a5558", "$description": "Dim rose, button fill on dark." }
    },
    "charcoal": {
      "900": { "$type": "color", "$value": "#262425", "$description": "Charcoal, the dark page." },
      "800": { "$type": "color", "$value": "#2d2a2b", "$description": "Raised charcoal, the dark surface." },
      "700": { "$type": "color", "$value": "#443f40", "$description": "Charcoal line, hairlines on dark." },
      "300": { "$type": "color", "$value": "#b9b2b0", "$description": "Soft grey, dark text." },
      "200": { "$type": "color", "$value": "#cac4c2", "$description": "Light grey, dark headings." },
      "400": { "$type": "color", "$value": "#9a9392", "$description": "Mid grey, dark muted text." }
    },
    "paper": {
      "100": { "$type": "color", "$value": "#f6efe8", "$description": "Warm paper, text on the light rose fill." },
      "200": { "$type": "color", "$value": "#efe8e8", "$description": "Pale paper, text on the dark rose fill." }
    }
  },
  "color": {
    "canvas": { "$type": "color", "$value": "{primitive.sand.200}", "$extensions": { "slipway": { "dark": "{primitive.charcoal.900}" } }, "$description": "Page background." },
    "surface": { "$type": "color", "$value": "{primitive.sand.100}", "$extensions": { "slipway": { "dark": "{primitive.charcoal.800}" } }, "$description": "Raised areas: code blocks, cards." },
    "text": { "$type": "color", "$value": "{primitive.ink.700}", "$extensions": { "slipway": { "dark": "{primitive.charcoal.300}" } }, "$description": "Body text." },
    "heading": { "$type": "color", "$value": "{primitive.ink.700}", "$extensions": { "slipway": { "dark": "{primitive.charcoal.200}" } }, "$description": "Headings." },
    "muted": { "$type": "color", "$value": "{primitive.ink.500}", "$extensions": { "slipway": { "dark": "{primitive.charcoal.400}" } }, "$description": "Secondary text and captions." },
    "line": { "$type": "color", "$value": "{primitive.sand.300}", "$extensions": { "slipway": { "dark": "{primitive.charcoal.700}" } }, "$description": "Hairline rules and borders." },
    "rose": { "$type": "color", "$value": "{primitive.rose.700}", "$extensions": { "slipway": { "dark": "{primitive.rose.400}" } }, "$description": "Accent for links, numbers, and marks." },
    "rose-fill": { "$type": "color", "$value": "{primitive.rose.700}", "$extensions": { "slipway": { "dark": "{primitive.rose.600}" } }, "$description": "Background of filled buttons." },
    "on-rose-fill": { "$type": "color", "$value": "{primitive.paper.100}", "$extensions": { "slipway": { "dark": "{primitive.paper.200}" } }, "$description": "Text on filled buttons." },
    "rose-hover": { "$type": "css", "$value": "color-mix(in oklch, var(--sl-color-rose), var(--sl-color-text) 18%)", "$description": "Link hover, derived from the accent. Not part of contrast pairs." }
  },
  "font": {
    "display": { "$type": "fontFamily", "$value": "\"Instrument Serif\", Georgia, \"Times New Roman\", serif", "$description": "Large editorial headings (Latin)." },
    "body": { "$type": "fontFamily", "$value": "\"Source Serif 4\", Georgia, serif", "$description": "Reading text (Latin)." },
    "ui": { "$type": "fontFamily", "$value": "system-ui, -apple-system, \"Segoe UI\", sans-serif", "$description": "Interface chrome: header, navigation, badges, buttons." },
    "mono": { "$type": "fontFamily", "$value": "\"IBM Plex Mono\", ui-monospace, Menlo, Consolas, monospace", "$description": "Code." },
    "persian": { "$type": "fontFamily", "$value": "Vazirmatn, Tahoma, sans-serif", "$description": "All Persian text." }
  },
  "step": {
    "sm": { "$type": "dimension", "$value": "clamp(0.8125rem, 0.79rem + 0.1vw, 0.875rem)", "$description": "Small text step." },
    "base": { "$type": "dimension", "$value": "clamp(1rem, 0.96rem + 0.2vw, 1.125rem)", "$description": "Body text step." },
    "lg": { "$type": "dimension", "$value": "clamp(1.25rem, 1.15rem + 0.5vw, 1.5rem)", "$description": "Lead text and h3 step." },
    "xl": { "$type": "dimension", "$value": "clamp(1.625rem, 1.4rem + 1.1vw, 2.25rem)", "$description": "h2 step." },
    "2xl": { "$type": "dimension", "$value": "clamp(2.125rem, 1.7rem + 2vw, 3.25rem)", "$description": "h1 step." },
    "3xl": { "$type": "dimension", "$value": "clamp(2.75rem, 2rem + 3.5vw, 4.75rem)", "$description": "Display step for the home page." }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "0.25rem", "$description": "4px." },
    "2": { "$type": "dimension", "$value": "0.5rem", "$description": "8px." },
    "3": { "$type": "dimension", "$value": "0.75rem", "$description": "12px." },
    "4": { "$type": "dimension", "$value": "1rem", "$description": "16px." },
    "6": { "$type": "dimension", "$value": "1.5rem", "$description": "24px." },
    "8": { "$type": "dimension", "$value": "2rem", "$description": "32px." },
    "12": { "$type": "dimension", "$value": "3rem", "$description": "48px." },
    "16": { "$type": "dimension", "$value": "4rem", "$description": "64px." }
  },
  "radius": {
    "compact": { "$type": "dimension", "$value": "0.375rem", "$description": "Badges, buttons, code blocks." },
    "card": { "$type": "dimension", "$value": "0.75rem", "$description": "Cards and panels." }
  },
  "measure": { "$type": "dimension", "$value": "42rem", "$description": "Maximum width of reading text." },
  "rule": { "$type": "dimension", "$value": "1px", "$description": "Hairline rule width." },
  "button": {
    "bg": { "$type": "color", "$value": "{color.rose-fill}", "$description": "Filled button background." },
    "fg": { "$type": "color", "$value": "{color.on-rose-fill}", "$description": "Filled button text." },
    "radius": { "$type": "dimension", "$value": "{radius.compact}", "$description": "Button corner radius." }
  }
}

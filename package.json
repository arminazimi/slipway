{
  "name": "slipway-repo",
  "private": true,
  "description": "Slipway: an editorial, RTL-ready, agent-native docs engine and theme.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "plugins/*/*"
  ],
  "scripts": {
    "test": "node tools/check.ts --test",
    "check": "node tools/check.ts",
    "check:tools": "node tools/check.ts --tools",
    "check:schemas": "node tools/theme/validate.ts",
    "check:docs": "node tools/theme/config-doc.ts --check && node tools/theme/front-matter-doc.ts --check",
    "roadmap:build": "node planning/roadmap/build.ts",
    "roadmap:apply": "node planning/roadmap/apply.ts",
    "build:brand": "node tools/brand/build.ts",
    "export:brand": "node tools/brand/export.ts",
    "check:brand": "node tools/brand/build.ts --check",
    "build:tokens": "node tools/theme/tokens-build.ts",
    "check:tokens": "node tools/theme/tokens-build.ts --check",
    "check:contrast": "node tools/theme/contrast.ts",
    "check:logical": "node tools/theme/logical-css.ts",
    "check:js": "node tools/theme/js-budget.ts",
    "check:css": "node tools/theme/css-budget.ts",
    "build:skills": "node tools/skills/config-reference.ts",
    "build:docs": "node tools/theme/config-doc.ts && node tools/theme/front-matter-doc.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "ajv": "^8.20.0",
    "chrome-launcher": "^1.2.3",
    "lighthouse": "^13.6.0",
    "playwright-core": "^1.65.0",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  }
}

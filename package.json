{
  "name": "slipway-repo",
  "private": true,
  "description": "Slipway: an editorial, RTL-ready, agent-native site template, verified by Seaworthy.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"planning/roadmap/*.test.mjs\" \"tools/brand/*.test.mjs\" \"tools/theme/*.test.mjs\" \"tools/seaworthy/*.test.mjs\"",
    "check": "node planning/roadmap/build.mjs --check && npm run test --silent && npm run check:brand --silent && npm run check:site --silent",
    "seaworthy:setup": "node tools/seaworthy/setup.mjs",
    "check:site": "node tools/theme/check.mjs",
    "roadmap:build": "node planning/roadmap/build.mjs",
    "roadmap:apply": "node planning/roadmap/apply.mjs",
    "build:brand": "node tools/brand/build.mjs",
    "export:brand": "node tools/brand/export.mjs",
    "check:brand": "node tools/brand/build.mjs --check"
  }
}

{
  "name": "slipway-repo",
  "private": true,
  "description": "Slipway: an editorial, RTL-ready, agent-native docs engine and theme.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "plugins/*/*"
  ],
  "scripts": {
    "test": "node tools/check.mjs --test",
    "check": "node tools/check.mjs",
    "check:tools": "node tools/check.mjs --tools",
    "check:schemas": "node tools/theme/validate.mjs",
    "check:docs": "node tools/theme/config-doc.mjs --check && node tools/theme/front-matter-doc.mjs --check",
    "roadmap:build": "node planning/roadmap/build.mjs",
    "roadmap:apply": "node planning/roadmap/apply.mjs",
    "build:brand": "node tools/brand/build.mjs",
    "export:brand": "node tools/brand/export.mjs",
    "check:brand": "node tools/brand/build.mjs --check",
    "build:tokens": "node tools/theme/tokens-build.mjs",
    "check:tokens": "node tools/theme/tokens-build.mjs --check",
    "check:contrast": "node tools/theme/contrast.mjs",
    "check:logical": "node tools/theme/logical-css.mjs",
    "check:js": "node tools/theme/js-budget.mjs",
    "check:css": "node tools/theme/css-budget.mjs",
    "build:skills": "node tools/skills/config-reference.mjs && node tools/skills/front-matter-reference.mjs",
    "build:docs": "node tools/theme/config-doc.mjs && node tools/theme/front-matter-doc.mjs"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  }
}

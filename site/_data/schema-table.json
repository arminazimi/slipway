{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Widget options",
  "type": "object",
  "required": ["name"],
  "properties": {
    "name": {
      "type": "string",
      "description": "The widget's name."
    },
    "size": {
      "type": "string",
      "enum": ["s", "m", "l"],
      "default": "m",
      "description": "The widget's size."
    },
    "visible": {
      "type": "boolean",
      "default": true,
      "description": "Whether the widget shows on the page."
    }
  }
}

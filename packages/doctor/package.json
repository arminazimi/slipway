{
  "name": "slipway",
  "version": "0.0.0",
  "private": true,
  "description": "slipway doctor: checks a static site's source and built output against the agent-editable site spec, for any generator.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "slipway": "bin/slipway.ts"
  },
  "exports": {
    ".": "./src/doctor.ts",
    "./detect": "./src/detect.ts",
    "./yaml": "./src/yaml.ts",
    "./deprecations": "./src/deprecations.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "files": [
    "bin",
    "src",
    "spec",
    "schema",
    "docs"
  ],
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "yaml": "^2.9.1"
  }
}

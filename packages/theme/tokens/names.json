    "card": "0.625rem"
  },
  "shadow": {
    "sm": "0 1px 2px rgb(0 0 0 / 0.1)",
    "md": "0 4px 8px rgb(0 0 0 / 0.12)",
    "lg": "0 12px 24px rgb(0 0 0 / 0.16)",
    "popover": "0 8px 24px rgb(0 0 0 / 0.28)",
    "dialog": "0 16px 48px rgb(0 0 0 / 0.4)"

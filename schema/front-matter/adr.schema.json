{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arminazimi/slipway/schema/front-matter/adr.schema.json",
  "title": "ADR front matter",
  "type": "object",
  "allOf": [
    {
      "$ref": "base.schema.json"
    }
  ],
  "properties": {
    "date": {
      "$ref": "base.schema.json#/$defs/date",
      "description": "The date this decision was recorded."
    },
    "deciders": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The people who made this decision."
    },
    "layout": {
      "const": "adr",
      "description": "The ADR layout."
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "accepted",
        "rejected",
        "superseded",
        "deprecated"
      ],
      "description": "The decision's lifecycle status."
    },
    "superseded_by": {
      "type": "string",
      "description": "The title of the ADR that replaces this decision."
    },
    "supersedes": {
      "type": "string",
      "description": "The title of the ADR replaced by this decision."
    }
  },
  "required": [
    "layout",
    "title",
    "status"
  ],
  "description": "An architecture decision record with status, deciders, and supersession links."
}

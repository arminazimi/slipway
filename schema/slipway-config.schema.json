{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arminazimi/slipway/schema/slipway-config.schema.json",
  "title": "Slipway site configuration",
  "description": "The slipway block of _config.yml. Other keys belong to Jekyll and are not checked here.",
  "type": "object",
  "properties": {
    "slipway": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "languages": {
          "type": "array",
          "description": "Languages of the site, in switcher order. Pages join by lang and translation_key in front matter; prefix is the URL folder of the language home ('' for the default language).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "name", "prefix"],
            "properties": {
              "code": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)?$" },
              "name": { "type": "string", "minLength": 1 },
              "prefix": { "type": "string", "pattern": "^(/[a-z0-9-]+)?$" }
            }
          }
        },
        "tokens": {
          "type": "object",
          "description": "Overrides for theme tokens. Each key maps to CSS variables in tools/theme/config-map.mjs.",
          "additionalProperties": false,
          "properties": {
            "accent": { "$ref": "#/$defs/color", "description": "Accent for links, marks, and filled buttons, in both light and dark." },
            "canvas": { "$ref": "#/$defs/color", "description": "Page background, in both light and dark." },
            "text": { "$ref": "#/$defs/color", "description": "Body text color, in both light and dark." },
            "font_display": { "$ref": "#/$defs/fontStack", "description": "Large headings (Latin)." },
            "font_body": { "$ref": "#/$defs/fontStack", "description": "Reading text (Latin)." },
            "radius": { "$ref": "#/$defs/length", "description": "Corner radius of cards." }
          }
        }
      }
    }
  },
  "$defs": {
    "color": {
      "type": "string",
      "anyOf": [{ "pattern": "^#[0-9a-fA-F]{6}$" }, { "pattern": "^oklch\\([0-9. %/]+\\)$" }]
    },
    "fontStack": { "type": "string", "pattern": "^[A-Za-z0-9 ,'\"_-]{1,200}$" },
    "length": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(rem|em|px)$" }
  }
}

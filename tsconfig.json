{
  "//": "Type check for code outside the workspaces with their own tsconfig.json: tools/, planning/, action/, and the fixture generators. Code converted from JavaScript starts non-strict; tighten a folder to strict when you change it substantially.",
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": [
      "esnext",
      "dom"
    ],
    "types": [
      "node"
    ],
    "strict": false,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "tools/**/*.ts",
    "planning/**/*.ts",
    "action/**/*.ts"
  ],
  "exclude": [
    "**/fixtures/**",
    "node_modules"
  ],
  "files": [
    "fixtures/docs-site/generate.ts",
    "examples/product-docs/generate.ts"
  ]
}
